name: sentinel-alert-status-sync
description: >-
  Elastic to Sentinel alert status sync. Every minute, finds Elastic Security alerts an analyst has
  acknowledged or closed in the last 3 minutes and sets the matching Microsoft Sentinel incident to
  Active or Closed. The incident is found by the Sentinel incident id on the alert (alerts raised from
  Sentinel incidents) or by the [alert-uuid:...] marker in the incident description (alerts Elastic
  sent to Sentinel). Incidents already in the target state are left alone.
enabled: true
tags:
  - sentinel
  - alert-sync
triggers:
  - type: scheduled
    with:
      every: "1m"
consts:
  tenant_id: "${tenant_id}"
  client_id: "${client_id}"
  client_secret: "${client_secret}"
  incidents_url: "${incidents_url}"
steps:
  - name: changed_alerts
    type: elasticsearch.search
    with:
      index: ".alerts-security.alerts-default"
      size: 50
      query:
        bool:
          filter:
            - terms:
                kibana.alert.workflow_status: ["acknowledged", "closed"]
            - range:
                kibana.alert.workflow_status_updated_at:
                  gte: "now-3m"
            - terms:
                kibana.alert.rule.name: ${rule_names_json}

  - name: get_token
    type: http
    if: "steps.changed_alerts.output.hits.total.value > 0"
    with:
      url: "https://login.microsoftonline.com/{{ consts.tenant_id }}/oauth2/v2.0/token"
      method: POST
      headers:
        Content-Type: "application/x-www-form-urlencoded"
      body: "grant_type=client_credentials&client_id={{ consts.client_id }}&client_secret={{ consts.client_secret }}&scope=https%3A%2F%2Fmanagement.azure.com%2F.default"

  - name: sync_each_alert
    type: foreach
    if: "steps.changed_alerts.output.hits.total.value > 0"
    foreach: "$${{ steps.changed_alerts.output.hits.hits }}"
    steps:
      - name: prepare
        type: data.set
        with:
          has_name: "{% if foreach.item._source.azure.eventhub.IncidentName %}yes{% else %}no{% endif %}"
          incident_name: "{{ foreach.item._source.azure.eventhub.IncidentName }}"
          target_status: "{% if foreach.item._source['kibana.alert.workflow_status'] == 'closed' %}Closed{% else %}Active{% endif %}"
          classification: "{% case foreach.item._source['kibana.alert.workflow_reason'] %}{% when 'false_positive' %}FalsePositive{% when 'true_positive' %}TruePositive{% when 'benign_positive' %}BenignPositive{% else %}Undetermined{% endcase %}"
          classification_reason: "{% case foreach.item._source['kibana.alert.workflow_reason'] %}{% when 'false_positive' %}InaccurateData{% when 'true_positive' %}SuspiciousActivity{% when 'benign_positive' %}SuspiciousButExpected{% else %}{% endcase %}"

      # --- alerts raised from a Sentinel incident: the incident id is on the alert ---
      - name: get_by_id
        type: http
        if: "variables.has_name : \"yes\""
        on-failure:
          continue: true
        with:
          url: "{{ consts.incidents_url }}/{{ variables.incident_name }}?api-version=2023-02-01"
          method: GET
          headers:
            Authorization: "Bearer {{ steps.get_token.output.data.access_token }}"

      - name: update_by_id
        type: http
        if: "variables.has_name : \"yes\" and steps.get_by_id.output.status : 200 and ((variables.target_status : \"Closed\" and not steps.get_by_id.output.data.properties.status : \"Closed\") or (variables.target_status : \"Active\" and steps.get_by_id.output.data.properties.status : \"New\"))"
        on-failure:
          continue: true
        with:
          url: "{{ consts.incidents_url }}/{{ variables.incident_name }}?api-version=2023-02-01"
          method: PUT
          headers:
            Authorization: "Bearer {{ steps.get_token.output.data.access_token }}"
            Content-Type: "application/json"
          # The incident PUT replaces the whole incident, so send back everything we read
          # (description, labels, owner) and change only the status and classification.
          body: '{"etag": {{ steps.get_by_id.output.data.etag | json }}, "properties": {"title": {{ steps.get_by_id.output.data.properties.title | json }}, "description": {{ steps.get_by_id.output.data.properties.description | json }}, "severity": {{ steps.get_by_id.output.data.properties.severity | json }}, "labels": {{ steps.get_by_id.output.data.properties.labels | json }}, "owner": {{ steps.get_by_id.output.data.properties.owner | json }}, "status": "{{ variables.target_status }}"{% if variables.target_status == "Closed" %}, "classification": "{{ variables.classification }}"{% if variables.classification_reason != "" %}, "classificationReason": "{{ variables.classification_reason }}"{% endif %}{% endif %}}}'

      # --- alerts Elastic sent to Sentinel: find the incident by the alert uuid in its description ---
      - name: find_by_marker
        type: http
        if: "variables.has_name : \"no\""
        on-failure:
          continue: true
        with:
          url: "{{ consts.incidents_url }}?api-version=2023-02-01&$filter=contains(properties/description,'[alert-uuid:{{ foreach.item._id }}]')"
          method: GET
          headers:
            Authorization: "Bearer {{ steps.get_token.output.data.access_token }}"

      - name: update_found
        type: http
        if: "variables.has_name : \"no\" and steps.find_by_marker.output.data.value.0.name : * and ((variables.target_status : \"Closed\" and not steps.find_by_marker.output.data.value.0.properties.status : \"Closed\") or (variables.target_status : \"Active\" and steps.find_by_marker.output.data.value.0.properties.status : \"New\"))"
        on-failure:
          continue: true
        with:
          url: "{{ consts.incidents_url }}/{{ steps.find_by_marker.output.data.value[0].name }}?api-version=2023-02-01"
          method: PUT
          headers:
            Authorization: "Bearer {{ steps.get_token.output.data.access_token }}"
            Content-Type: "application/json"
          # The incident PUT replaces the whole incident, so send back everything we read
          # (description, labels, owner) and change only the status and classification.
          body: '{"etag": {{ steps.find_by_marker.output.data.value[0].etag | json }}, "properties": {"title": {{ steps.find_by_marker.output.data.value[0].properties.title | json }}, "description": {{ steps.find_by_marker.output.data.value[0].properties.description | json }}, "severity": {{ steps.find_by_marker.output.data.value[0].properties.severity | json }}, "labels": {{ steps.find_by_marker.output.data.value[0].properties.labels | json }}, "owner": {{ steps.find_by_marker.output.data.value[0].properties.owner | json }}, "status": "{{ variables.target_status }}"{% if variables.target_status == "Closed" %}, "classification": "{{ variables.classification }}"{% if variables.classification_reason != "" %}, "classificationReason": "{{ variables.classification_reason }}"{% endif %}{% endif %}}}'

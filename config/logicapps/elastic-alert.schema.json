{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Elastic alert pushed to Log Analytics",
  "type": "object",
  "properties": {
    "rule_name": {"type": "string"},
    "rule_id": {"type": "string"},
    "severity": {"type": "string"},
    "risk_score": {"type": ["string", "number"]},
    "reason": {"type": "string"},
    "timestamp": {"type": "string"},
    "host_name": {"type": "string"},
    "message": {"type": "string"},
    "alert_id": {"type": "string"},
    "alert_uuid": {"type": "string"},
    "kibana_alert_url": {"type": "string"}
  },
  "required": ["rule_name", "alert_id"]
}

// Sentinel NRT rule query. Custom table columns carry type suffixes (_s string, _d double, _t datetime).
ElasticAlerts_CL
| project
    TimeGenerated,
    rule_name_s,
    rule_id_s,
    severity_s,
    risk_score_s,
    reason_s,
    host_name_s,
    message_s,
    alert_id_s,
    kibana_alert_url_s
